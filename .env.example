# Copie este arquivo para .local/.env e preencha apenas na sua maquina.
# Nunca use valores reais neste arquivo versionado.

OPENAI_API_KEY=<sua-chave>
OPENROUTER_API_KEY=<sua-chave>
YOUTUBE_API_KEY=<sua-chave>
GEMINI_API_KEY=<sua-chave>

LINKEDIN_CLIENT_ID=<seu-client-id>
LINKEDIN_CLIENT_SECRET=<seu-client-secret>
LINKEDIN_ACCESS_TOKEN=<seu-token>
LINKEDIN_PERSON_URN=<seu-urn>

INSTAGRAM_APP_ID=<seu-app-id>
INSTAGRAM_APP_SECRET=<seu-app-secret>
INSTAGRAM_ACCESS_TOKEN=<seu-token>
INSTAGRAM_USER_ID=<seu-user-id>
INSTAGRAM_PAGE_ID=<seu-page-id>

X_API_KEY=<sua-chave>
X_API_SECRET=<seu-segredo>
X_ACCESS_TOKEN=<seu-token>
X_ACCESS_TOKEN_SECRET=<seu-segredo>
X_CALLBACK_URL=http://127.0.0.1:8080/callback

THREADS_APP_ID=<seu-app-id>
THREADS_APP_SECRET=<seu-app-secret>
THREADS_ACCESS_TOKEN=<seu-token>
THREADS_USER_ID=<seu-user-id>

CLARITY_DATA_EXPORT_TOKEN=<seu-token>
JULES_API_KEY=<sua-chave>
